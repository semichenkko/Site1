# Скопируйте этот файл в .env и заполните:  cp .env.example .env
# Файл .env НЕ коммитьте в git — там секреты.

# Ключ Claude API: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Модель ---
AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AGENT_EFFORT=high
AGENT_MAX_TOKENS=16000
AGENT_MAX_STEPS=25
# default — при отказе модели запрос автоматически повторяется на другой модели; off — выключить
AGENT_FALLBACKS=default

# --- Инструменты ---
AGENT_WORKSPACE=/data/workspace
# Поиск и чтение страниц в интернете
AGENT_WEB_TOOLS=true
# Выполнение команд в shell внутри контейнера. Включайте, только если понимаете риски.
AGENT_ALLOW_SHELL=false
AGENT_SHELL_TIMEOUT=60
# Свой системный промпт (необязательно), путь к файлу:
# AGENT_SYSTEM_PROMPT_FILE=/data/system_prompt.md

# --- Веб-интерфейс ---
# Обязательно задайте длинный пароль, иначе веб-чат не заработает
WEB_PASSWORD=
WEB_PORT=8000

# --- Telegram (необязательно) ---
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram ID пользователей через запятую (бот подскажет ваш ID при первом сообщении)
TELEGRAM_ALLOWED_USERS=
